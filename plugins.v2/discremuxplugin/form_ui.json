[
  {
    "component": "VForm",
    "content": [
      {
        "component": "VRow",
        "content": [
          {
            "component": "VCol",
            "props": {
              "cols": 12
            },
            "content": [
              {
                "component": "VAlert",
                "props": {
                  "type": "info",
                  "variant": "tonal",
                  "text": "通用配置会影响整理历史、已入库扫描和监听下载器重封装。已入库扫描会优先从硬链接库发现 BDMV，但只在对应源文件目录中重封装 MKV，再调用 MoviePilot 正常转移入库。"
                }
              }
            ]
          }
        ]
      },
      {
        "component": "VRow",
        "content": [
          {
            "component": "VCol",
            "props": {
              "cols": 12,
              "md": 3
            },
            "content": [
              {
                "component": "VTextField",
                "props": {
                  "model": "min_mkv_size_gb",
                  "label": "跳过阈值 (GB)",
                  "type": "number",
                  "min": 1,
                  "placeholder": "5"
                }
              }
            ]
          },
          {
            "component": "VCol",
            "props": {
              "cols": 12,
              "md": 3
            },
            "content": [
              {
                "component": "VSwitch",
                "props": {
                  "model": "movies_only",
                  "label": "只处理电影"
                }
              }
            ]
          },
          {
            "component": "VCol",
            "props": {
              "cols": 12,
              "md": 3
            },
            "content": [
              {
                "component": "VSelect",
                "props": {
                  "model": "source_disc_action",
                  "label": "源文件 ISO/BDMV 处理",
                  "hint": "选择删除时会绑定删除下载器原任务，避免源文件不存在后继续做种报错。",
                  "persistent-hint": true,
                  "items": [
                    {"title": "保留源文件原盘和下载器任务", "value": "keep"},
                    {"title": "成功入库后删除源文件原盘，并删除下载器原任务", "value": "delete"}
                  ]
                }
              }
            ]
          },
          {
            "component": "VCol",
            "props": {
              "cols": 12,
              "md": 3
            },
            "content": [
              {
                "component": "VSwitch",
                "props": {
                  "model": "refresh_media_server",
                  "label": "尝试刷新对应媒体库"
                }
              }
            ]
          },
          {
            "component": "VCol",
            "props": {
              "cols": 12,
              "md": 3
            },
            "content": [
              {
                "component": "VSwitch",
                "props": {
                  "model": "normalize_tracks",
                  "label": "规范化轨道标题"
                }
              }
            ]
          },
          {
            "component": "VCol",
            "props": {
              "cols": 12,
              "md": 3
            },
            "content": [
              {
                "component": "VSwitch",
                "props": {
                  "model": "reset_video_language",
                  "label": "视频轨语言设为未定"
                }
              }
            ]
          }
        ]
      },
      {
        "component": "VDivider",
        "props": {
          "class": "my-4"
        }
      },
      {
        "component": "VTabs",
        "props": {
          "model": "_tabs",
          "fixed-tabs": true
        },
        "content": [
          {
            "component": "VTab",
            "props": {
              "value": "history_tab"
            },
            "text": "整理历史重封装"
          },
          {
            "component": "VTab",
            "props": {
              "value": "library_scan_tab"
            },
            "text": "已入库原盘扫描"
          },
          {
            "component": "VTab",
            "props": {
              "value": "intercept_tab"
            },
            "text": "监听下载器重封装"
          }
        ]
      },
      {
        "component": "VWindow",
        "props": {
          "model": "_tabs",
          "style": {
            "padding-top": "24px",
            "padding-bottom": "24px"
          }
        },
        "content": [
          {
            "component": "VWindowItem",
            "props": {
              "value": "history_tab"
            },
            "content": [
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VSwitch",
                        "props": {
                          "model": "history_enabled",
                          "label": "启用定时重封装"
                        }
                      }
                    ]
                  },
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VSwitch",
                        "props": {
                          "model": "run_once",
                          "label": "保存后立即运行一次"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12
                    },
                    "content": [
                      {
                        "component": "VAlert",
                        "props": {
                          "type": "info",
                          "variant": "tonal",
                          "text": "整理历史模式会扫描最近整理记录，在媒体库已入库的原盘目录中重封装 MKV，并按配置处理旧 BDMV。"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VCronField",
                        "props": {
                          "model": "cron_schedule",
                          "label": "定时运行策略 (Cron 表达式)",
                          "placeholder": "例如: 0 3 * * *"
                        }
                      }
                    ]
                  },
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VTextField",
                        "props": {
                          "model": "recent_days",
                          "label": "查询最近整理记录天数",
                          "type": "number",
                          "min": 1,
                          "placeholder": "7"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12
                    },
                    "content": [
                      {
                        "component": "VSelect",
                        "props": {
                          "model": "library_disc_action",
                          "label": "旧入库 ISO/BDMV 处理",
                          "hint": "仅在新 MKV 成功硬链接入库后处理媒体库里旧原盘残留，不会删除新 MKV。",
                          "persistent-hint": true,
                          "items": [
                            {"title": "不处理", "value": "keep"},
                            {"title": "写 .ignore", "value": "ignore"},
                            {"title": "删除旧 BDMV/CERTIFICATE 或旧 ISO/IMG", "value": "delete"}
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "component": "VWindowItem",
            "props": {
              "value": "library_scan_tab"
            },
            "content": [
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VSwitch",
                        "props": {
                          "model": "library_scan_enabled",
                          "label": "启用已入库原盘扫描"
                        }
                      }
                    ]
                  },
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VSwitch",
                        "props": {
                          "model": "library_scan_run_once",
                          "label": "保存后立即扫描一次"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12
                    },
                    "content": [
                      {
                        "component": "VAlert",
                        "props": {
                          "type": "warning",
                          "variant": "tonal",
                          "text": "该模式会扫描源文件与硬链接库中的 BDMV；硬链接库只作为发现线索，必须能映射到源文件目录才会处理。输出 MKV 写入源文件目录后由 MP 正常转移，避免手工搬运硬链接库。"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VTextField",
                        "props": {
                          "model": "source_roots",
                          "label": "源文件根目录（每行一个，只从这里找原盘）",
                          "placeholder": "/PT/mp/源文件\n/PT/ms/源文件"
                        }
                      }
                    ]
                  },
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VTextField",
                        "props": {
                          "model": "library_root",
                          "label": "硬链接库根目录",
                          "placeholder": "/PT/mp/硬链接"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VCronField",
                        "props": {
                          "model": "library_scan_cron",
                          "label": "已入库扫描 Cron",
                          "placeholder": "例如: 30 3 * * *"
                        }
                      }
                    ]
                  },
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VTextField",
                        "props": {
                          "model": "library_scan_max_items",
                          "label": "单次最多处理候选数",
                          "type": "number",
                          "min": 1,
                          "placeholder": "50"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "component": "VWindowItem",
            "props": {
              "value": "intercept_tab"
            },
            "content": [
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VSwitch",
                        "props": {
                          "model": "intercept_enabled",
                          "label": "启用下载器完成后拦截重封装"
                        }
                      }
                    ]
                  },
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12,
                      "md": 6
                    },
                    "content": [
                      {
                        "component": "VSwitch",
                        "props": {
                          "model": "intercept_transfer_mkv",
                          "label": "重封装后发起整理"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "component": "VRow",
                "content": [
                  {
                    "component": "VCol",
                    "props": {
                      "cols": 12
                    },
                    "content": [
                      {
                        "component": "VAlert",
                        "props": {
                          "type": "info",
                          "variant": "tonal",
                          "text": "监听模式会在 MP 原盘整理前拦截，原整理记录会保留为失败；插件会在下载目录重封装 MKV，并用原下载历史中的媒体 ID 发起新整理。"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]